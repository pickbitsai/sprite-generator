{
  "name": "@pickbitsai/sprite-generator",
  "version": "2.1.0",
  "description": "Manifest-driven sprite generation, identity-locked pose sheets, animation harvesting, and deterministic visual verification.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sprite-generator": "./generate.js",
    "sprite-preview": "./preview.js"
  },
  "scripts": {
    "generate": "node generate.js",
    "preview": "node preview.js",
    "test": "node --test test/core.test.mjs test/loop-contract.test.mjs",
    "test:consumer": "node test/consumer-install.mjs",
    "leakscan": "node test/leakscan.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "preflight": "npm run leakscan && npm run audit:prod && npm test && npm run test:consumer",
    "prepublishOnly": "npm run preflight"
  },
  "files": [
    "generate.js",
    "preview.js",
    "contracts/",
    "docs/",
    "lib/",
    "templates/",
    "!templates/*/screenshot.png",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "loop.manifest.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pickbitsai/sprite-generator.git"
  },
  "homepage": "https://github.com/pickbitsai/sprite-generator#readme",
  "bugs": {
    "url": "https://github.com/pickbitsai/sprite-generator/issues"
  },
  "keywords": [
    "sprite",
    "generator",
    "agentic-workflow",
    "openai",
    "imagen",
    "game-assets",
    "gpt-image",
    "sprite-sheet",
    "visual-verification"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@google/genai": "^1.49.0",
    "dotenv": "^17.4.1",
    "openai": "^4.85.0",
    "playwright-core": "^1.59.1",
    "sharp": "^0.35.3"
  }
}
