{
  "name": "sprite-generator",
  "version": "2.0.0",
  "description": "Sprite generation toolkit: manifest-based asset generation, animation frame assembly, identity-locked image editing, and the Street Fury theme pipeline.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sprite-generator": "./generate.js",
    "sprite-preview": "./preview.js"
  },
  "scripts": {
    "generate": "node generate.js",
    "preview": "node preview.js",
    "theme": "node street-fury/generate-theme.js",
    "theme:validate": "node street-fury/validate-theme.js"
  },
  "files": [
    "generate.js",
    "preview.js",
    "lib/",
    "street-fury/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pickbitsai/sprite-generator.git"
  },
  "homepage": "https://github.com/pickbitsai/sprite-generator#readme",
  "bugs": {
    "url": "https://github.com/pickbitsai/sprite-generator/issues"
  },
  "keywords": [
    "sprite",
    "generator",
    "openai",
    "game-assets",
    "gpt-image"
  ],
  "dependencies": {
    "@google/genai": "^1.49.0",
    "dotenv": "^17.4.1",
    "openai": "^4.85.0",
    "playwright-core": "^1.59.1",
    "sharp": "^0.34.5"
  }
}
