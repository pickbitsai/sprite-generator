# Copy to .env and fill in. .env is gitignored.

# OpenAI — used by the default sprite-generator CLI (generate.js).
OPENAI_API_KEY=

# Google AI — used by the Street Fury theme pipeline and the Gemini sheet
# generator in examples/netrunner/.
GEMINI_API_KEY=

# Path to the Street Fury game project. Only needed when running
# `npm run theme` from the street-fury/ pipeline.
# GAME_ROOT=/path/to/Turtles

# Optional: switch the theme pipeline's image editor from Gemini to a local
# ComfyUI server.
# IMAGE_EDIT_PROVIDER=comfyui
# COMFYUI_URL=http://127.0.0.1:8188
