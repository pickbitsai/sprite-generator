# Copy to .env and fill in. .env is gitignored.

# OpenAI — used by generate.js, `pack`, and `animate` (seed-frame generation).
OPENAI_API_KEY=

# Replicate — used by `animate` for the image-to-video step.
REPLICATE_API_TOKEN=

# Google AI — used by `generate --backend imagen` and `pack --edit-provider gemini`.
GEMINI_API_KEY=
